:"exact","verified":true,"note":""}},{"decision":"2027-09-08","first_day":null,"effective":"2027-09-09","has_projections":false,"projections_name":null,"has_presser":true,"conference_local":"10:30","source":"official","date_verified":true,"time":{"tz":"America/Toronto","abbr":"EDT","local":"09:45","tbd":false,"window_local":null,"unverified":false,"utc":"2027-09-08T13:45:00Z"},"blackout":{"start":"2027-09-01T00:00:00-04:00","end":"2027-09-08T10:30:00-04:00","start_utc":"2027-09-01T04:00:00Z","end_utc":"2027-09-08T14:30:00Z","precision":"exact","verified":true,"note":""}},{"decision":"2027-10-27","first_day":null,"effective":"2027-10-28","has_projections":true,"projections_name":"Monetary Policy Report","has_presser":true,"conference_local":"10:30","source":"official","date_verified":true,"time":{"tz":"America/Toronto","abbr":"EDT","local":"09:45","tbd":false,"window_local":null,"unverified":false,"utc":"2027-10-27T13:45:00Z"},"blackout":{"start":"2027-10-19T00:00:00-04:00","end":"2027-10-27T10:30:00-04:00","start_utc":"2027-10-19T04:00:00Z","end_utc":"2027-10-27T14:30:00Z","precision":"exact","verified":true,"note":""}},{"decision":"2027-12-08","first_day":null,"effective":"2027-12-09","has_projections":false,"projections_name":null,"has_presser":true,"conference_local":"10:30","source":"official","date_verified":true,"time":{"tz":"America/Toronto","abbr":"EST","local":"09:45","tbd":false,"window_local":null,"unverified":false,"utc":"2027-12-08T14:45:00Z"},"blackout":{"start":"2027-12-01T00:00:00-05:00","end":"2027-12-08T10:30:00-05:00","start_utc":"2027-12-01T05:00:00Z","end_utc":"2027-12-08T15:30:00Z","precision":"exact","verified":true,"note":""}}],"sources":[{"id":"mx_corra","role":"primary","methods":["EXACT","WINDOW"],"license":"(c) Bourse de Montreal; 'for general information purposes only'. TMX Datalinx sells MX data 'for a single end user, no redistribution rights'.","url":"https://www.m-x.ca/en/trading/tools/canadian-interest-rate-expectations","asof":"2026-09-18","lag_bd":0,"stale":false,"proxy":false},{"id":"boc_tbills","role":"crosscheck","methods":["PROXY_TENOR"],"license":"Bank of Canada Terms of Use s.1: 'freely use, copy, distribute and transmit' with attribution.","url":"https://www.bankofcanada.ca/valet/observations/TB.CDN.30D.MID,TB.CDN.60D.MID,TB.CDN.90D.MID,TB.CDN.180D.MID/json","asof":"2026-09-17","lag_bd":1,"stale":false,"proxy":true}],"crosschecks":[{"name":"CAD COA chain vs CRA","period":"2026-09-16..2026-12-16","primary":2.338,"second":2.345,"diff_bp":0.72,"note":"same period; the CRA contract is inside the COA horizon","na":null}],"meta":{"asof":"2026-09-18","stale_after_bd":2,"flags":{"EXACT":{"label":"EXACT","help":"Solved exactly from 1M month-average futures: the rate changes only on the effective date, so the implied rate after the meeting follows from the monthly average."},"CURVE":{"label":"CURVE","help":"OIS forward curve averaged over the interval between effective dates, minus the overnight-to-policy spread."},"UPPER_BOUND":{"label":"UPPER BOUND","help":"3M contract window: the average covers several meetings, so the cumulative move is an upper bound for this meeting alone."},"PROXY":{"label":"PROXY","help":"Government-curve proxy - not policy-equivalent. Shown as a raw sovereign level unless a basis can be measured from a short tenor."},"DECIDED":{"label":"DECIDED","help":"The meeting has already been decided: it is part of the base rate."}},"level_help":{"policy":"implied policy rate","bkbm":"BKBM level (ASX 90-day bank bills), not the OCR","sovereign_proxy":"sovereign proxy, not policy-equivalent"},"methodology":[{"title":"Base rate","text":"The last rate DECIDED on or before the as-of date, including a decision that has been announced but is not in force yet (shown as 'from <date>'). The Fed is the midpoint of the target range."},{"title":"Implied policy rate","text":"Market instruments give the overnight benchmark path; the benchmark-to-policy spread (median of the last 20 business days, excluding +-2 business days around rate changes and month-ends) is removed to get a policy-equivalent rate."},{"title":"Methods","text":"EXACT: 1M month-average futures chain. CURVE: OIS forward curve averaged between effective dates. UPPER BOUND: 3M contracts whose window spans several meetings. PROXY: government curves / bills, with a basis measured only from tenors observed before the first effective date - without one ('proxy without short end') no bp, step or probability is computed and only the raw level is shown."},{"title":"Step and probability","text":"For EXACT and CURVE the implied step at the next meeting is split into whole 25 bp moves (n = floor(|step|/25)) and a fraction p of one more: P(n+1 moves) = p, P(n moves) = 1 - p, in the direction of the step."},{"title":"Cumulative bp","text":"Implied policy rate after the last meeting of the year minus the base rate, in bp. Positive = hawkish."},{"title":"Repricing","text":"Change of the implied level at a fixed horizon (last meeting of 2026 / 2027) over 5 business days (1w) and 21 business days (1m); independent of decisions taken in between. The change of the cumulative bp is a secondary field."},{"title":"GAP","text":"Market minus bank, in bp: the Fed's median dot vs the implied rate at the last meeting of each year. Only where both are on the same basis."},{"title":"Surprises and reaction","text":"Surprise vs consensus: decided rate minus consensus. Surprise vs market: decided step minus the step implied at T-1 (EXACT / CURVE / PROXY with a basis only). Reaction: change of the implied level between the close of T-1 and T at the next meeting and at the last meeting of the year."},{"title":"Pairs","text":"Base minus quote, metric by metric: the current rate differential (carry), the implied differential at year end (both legs policy-equivalent) and its repricing (both legs need a change of level). The flag is the weaker of the two legs."}]}}
