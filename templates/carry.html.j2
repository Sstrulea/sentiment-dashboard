<!DOCTYPE html>
<html lang="en">
<head>
  {% include '_theme_head.html.j2' %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carry | Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  {% include '_navbar.html.j2' %}

  <main class="page-content carry-page">
    <header class="econ-header">
      <h1>Carry</h1>
      <div class="econ-header-right">
        <div class="econ-meta-bar" id="carryMeta">
          <span class="muted">Loading…</span>
        </div>
      </div>
    </header>

    <div class="econ-legend">
      <span class="muted">Carry = the overnight interest-rate differential between the base and the
      quote currency, annualized for the LONG position. Blue = the long earns, red = the long pays.
      The scale saturates at ±5.00 pp. Wednesday night's rollover counts ×3 because it covers the
      weekend settlement — except USD/CAD, which settles T+1 and triples on Thursday. Excludes the
      broker's markup, which is deducted in both directions.</span>
    </div>

    <div class="econ-controls">
      <div id="carryDirFilter" class="cat-filter" role="group" aria-label="Direction">
        <span class="cat-filter-label">Direction:</span>
        <div class="cat-chips" id="carryDirChips"><!-- chips injected by carry.js --></div>
      </div>
      <div id="carryCcyFilter" class="cat-filter" role="group" aria-label="Filter by currency">
        <span class="cat-filter-label">Currency:</span>
        <div class="cat-chips" id="carryCcyChips"><!-- chips injected by carry.js --></div>
        <div class="cat-filter-actions">
          <button type="button" class="cat-action" data-action="all">All</button>
        </div>
      </div>
    </div>

    <section class="retail-table-wrapper">
      <div id="carryContent">
        <p class="muted" style="padding: 40px; text-align: center;">Loading carry…</p>
      </div>
    </section>
  </main>

  <script>window.CARRY_DATA_URL = "{{ data_url }}";</script>
  <script src="/score-palette.js"></script>
  <script src="/carry.js"></script>
</body>
</html>
