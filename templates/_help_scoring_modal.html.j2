<!-- Shared "How the score is computed" help button + modal — included from both
     economic.html.j2 and strength.html.j2 right after the page's legend
     paragraph, so the content lives in exactly one place (see also
     static/help-scoring.js for the shared open/close wiring). Reuses
     .modal/.modal-backdrop/.modal-content/.modal-close from static/style.css —
     same pattern as #econDetailModal (X, backdrop click, Escape all close it). -->
<p class="help-scoring-trigger" data-htr>
  <button type="button" id="helpScoringBtn" class="help-scoring-link" aria-haspopup="dialog">
    How the score is computed <span aria-hidden="true">?</span>
  </button>
</p>

<div id="helpScoringModal" class="modal" hidden>
  <div class="modal-backdrop"></div>
  <div class="modal-content help-scoring-content">
    <button class="modal-close" type="button" aria-label="Close">&times;</button>
    <h2>How the score is computed</h2>

    <p>We compare the surprise (Actual &minus; Forecast) with the last 12 surprises of the same indicator.
    Far beyond its usual size &rarr; &plusmn;2, above average &rarr; &plusmn;1, normal &rarr; 0.</p>

    <p>Scores are averaged within each category, then across categories &rarr; index. Rows without a
    forecast, or too old, do not enter the mean.</p>

    <p>N = how many indicators actually entered. A small N = less confidence.</p>
  </div>
</div>
