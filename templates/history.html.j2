<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Economic History | Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/chart.umd.min.js"></script>
  <script src="/chartjs-plugin-annotation.min.js"></script>
</head>
<body>
  {% include '_navbar.html.j2' %}

  <main class="page-content history-page">
    <header class="history-header">
      <h1>Economic History</h1>
      <div class="econ-meta-bar" id="historyMeta"><span class="muted">Loading…</span></div>
      <p class="subtitle">Print-by-print history behind <a href="/economic">Economic</a>'s
      surprise score — actual bars (step line for policy rates) colored by bucket, forecast tick per print,
      policy target where a matching series exists.</p>
    </header>

    <noscript>
      <p class="history-empty-category">This page needs JavaScript to render the chart and controls —
      please enable it and reload.</p>
    </noscript>

    <div class="history-controls">
      <div class="hc-group">
        <span class="cat-filter-label">Category:</span>
        <div class="history-cat-tabs" id="historyCatTabs" role="tablist" aria-label="Category"></div>
      </div>
      <div class="hc-group">
        <label for="historyCcySelect" class="cat-filter-label">Currency:</label>
        <select id="historyCcySelect" class="history-ccy-select"></select>
      </div>
      <div class="hc-group">
        <span class="cat-filter-label">Series:</span>
        <div class="history-series-chips" id="historySeriesChips"></div>
      </div>
    </div>

    <section class="chart-section">
      <p class="history-stale-banner" id="historyStaleBanner" hidden></p>
      <div class="history-strip" id="historyStrip"></div>
      <div class="chart-controls">
        <div class="window-selector" id="historyWindowSelector" role="tablist" aria-label="Time window"></div>
      </div>
      <div class="chart-wrapper">
        <canvas id="historyChart"></canvas>
      </div>
      <p class="history-target-note" id="historyTargetNote" hidden></p>
      <div class="history-legend" id="historyLegend"></div>
    </section>
  </main>

  <script>
    window.HISTORY_PAYLOAD = {{ payload_json | safe }};
  </script>
  <script src="/history.js"></script>
</body>
</html>
