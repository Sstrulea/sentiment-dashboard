<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>COT Dashboard — {{ report_date }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>
{% include '_navbar.html.j2' %}
<header class="topbar">
  <div class="brand">
    <h1>COT Dashboard</h1>
    <div class="dates">
      <span><strong>Report Date:</strong> {{ report_date }}</span>
      <span><strong>Generated:</strong> {{ generated_at }}</span>
    </div>
  </div>
  <div class="controls">
    <div id="catFilter" class="cat-filter" role="group" aria-label="Filter categories">
      <span class="cat-filter-label">Show:</span>
      <div class="cat-chips">
        {% for cat_key, cat in by_cat.items() %}
        <button type="button" class="cat-chip selected" data-cat="{{ cat_key }}" aria-pressed="true">
          <svg class="chip-box" viewBox="0 0 16 16" aria-hidden="true">
            <rect class="chip-box-rect" x="2" y="2" width="12" height="12" rx="2.5" ry="2.5"
                  fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path class="chip-box-check" d="M4.5 8.4l2.4 2.4L11.8 5.6" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round"/>
          </svg>
          <span>{{ cat.label }}</span>
        </button>
        {% endfor %}
      </div>
      <div class="cat-filter-actions">
        <button type="button" class="cat-action" data-action="all">All</button>
        <button type="button" class="cat-action" data-action="none">None</button>
      </div>
    </div>
    <button id="csvBtn" class="btn">⬇ CSV</button>
    <select id="archiveSel" class="btn">
      {% for d in archive|reverse %}
      <option value="archive/{{ d }}.html"{% if d == report_date %} selected{% endif %}>{{ d }}</option>
      {% endfor %}
    </select>
  </div>
</header>

{% if flips %}
<section id="flips">
  <h2>Flips into extremes this week</h2>
  <div class="flip-list">
    {% for f in flips %}
      <span class="flip-badge {{ 'flip-long' if f.direction == 'long' else 'flip-short' }}">
        <strong>{{ f.symbol }}</strong> {{ f.series }} → {{ f.direction|upper }} ({{ (f.extreme_value * 100)|round(0)|int }}%)
      </span>
    {% endfor %}
  </div>
</section>
{% else %}
<section id="flips" class="empty">
  <h2>Flips into extremes this week</h2>
  <p class="muted">No new extremes this week.</p>
</section>
{% endif %}

<main>
{% for cat_key, cat in by_cat.items() %}
<section class="cat" data-cat="{{ cat_key }}">
  <h2>{{ cat.label }}</h2>
  <div class="table-wrap">
    <table class="cot">
      <thead>
        <tr class="grp-row">
          <th rowspan="2" data-sort="symbol">Symbol</th>
          <th rowspan="2" data-sort="name">Name</th>
          <th colspan="5" class="grp-spec">Large Speculators</th>
          <th colspan="5" class="grp-comm">Commercials</th>
          <th rowspan="2">Trend</th>
        </tr>
        <tr class="sub-row">
          <th data-sort="spec_exp_long" class="col-spec first-spec">Exposure Long</th>
          <th data-sort="spec_exp_short" class="col-spec">Exposure Short</th>
          <th data-sort="spec_net" class="col-spec">Net Position</th>
          <th data-sort="spec_ext_6m" class="col-spec">Extremes 6M</th>
          <th data-sort="spec_ext_3y" class="col-spec">Extremes 3Y</th>
          <th data-sort="comm_exp_long" class="col-comm first-comm">Exposure Long</th>
          <th data-sort="comm_exp_short" class="col-comm">Exposure Short</th>
          <th data-sort="comm_net" class="col-comm">Net Position</th>
          <th data-sort="comm_ext_6m" class="col-comm">Extremes 6M</th>
          <th data-sort="comm_ext_3y" class="col-comm">Extremes 3Y</th>
        </tr>
      </thead>
      <tbody>
        {% for r in cat.rows %}
        {% if r.missing %}
        <tr class="row-missing">
          <td>{{ r.symbol }}</td>
          <td>{{ r.name }}</td>
          <td colspan="11" class="muted">no data</td>
        </tr>
        {% else %}
        <tr data-symbol="{{ r.symbol }}"
            data-spec_exp_long="{{ r.spec_exp_long }}"
            data-spec_exp_short="{{ r.spec_exp_short }}"
            data-spec_net="{{ r.spec_net }}"
            data-spec_ext_6m="{{ r.spec_ext_6m }}"
            data-spec_ext_3y="{{ r.spec_ext_3y }}"
            data-comm_exp_long="{{ r.comm_exp_long }}"
            data-comm_exp_short="{{ r.comm_exp_short }}"
            data-comm_net="{{ r.comm_net }}"
            data-comm_ext_6m="{{ r.comm_ext_6m }}"
            data-comm_ext_3y="{{ r.comm_ext_3y }}"
            class="{% if r.spec_flipped or r.comm_flipped %}row-flip{% endif %}">
          <td class="sym">{{ r.symbol }}</td>
          <td class="name">{{ r.name }}</td>
          <td class="col-spec first-spec {{ r.spec_exp_long_class }}">{{ r.fmt_spec_long_pct }}</td>
          <td class="col-spec">{{ r.fmt_spec_short_pct }}</td>
          <td class="col-spec num {% if r.spec_net_top3 %}net-top{% endif %}">{{ r.fmt_spec_net }}</td>
          <td class="col-spec {{ r.spec_ext_6m_class }}">{{ r.fmt_spec_ext_6m }}</td>
          <td class="col-spec {{ r.spec_ext_3y_class }}">{{ r.fmt_spec_ext_3y }}</td>
          <td class="col-comm first-comm {{ r.comm_exp_long_class }}">{{ r.fmt_comm_long_pct }}</td>
          <td class="col-comm">{{ r.fmt_comm_short_pct }}</td>
          <td class="col-comm num {% if r.comm_net_top3 %}net-top{% endif %}">{{ r.fmt_comm_net }}</td>
          <td class="col-comm {{ r.comm_ext_6m_class }}">{{ r.fmt_comm_ext_6m }}</td>
          <td class="col-comm {{ r.comm_ext_3y_class }}">{{ r.fmt_comm_ext_3y }}</td>
          <td class="spark-cell">{{ r.sparkline | safe }}</td>
        </tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endfor %}
</main>

<footer>
  <p class="muted">Data: CFTC Legacy Combined (Futures + Options). Percentile rank over trailing 26 (6M) / 156 (3Y) weeks.</p>
</footer>

<script>
(function () {
  // Category filter (checkbox-chip semantics: "show what's checked")
  const chips = Array.from(document.querySelectorAll('#catFilter .cat-chip'));
  function applyChip(chip) {
    const cat = chip.getAttribute('data-cat');
    const shown = chip.classList.contains('selected');
    chip.setAttribute('aria-pressed', shown ? 'true' : 'false');
    document.querySelectorAll(`section.cat[data-cat="${cat}"]`).forEach(s => {
      s.style.display = shown ? '' : 'none';
    });
  }
  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chip.classList.toggle('selected');
      applyChip(chip);
    });
    applyChip(chip);
  });
  document.querySelectorAll('#catFilter .cat-action').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.getAttribute('data-action');
      chips.forEach(chip => {
        if (action === 'all') chip.classList.add('selected');
        else if (action === 'none') chip.classList.remove('selected');
        applyChip(chip);
      });
    });
  });

  // Sortable tables
  document.querySelectorAll('table.cot').forEach(table => {
    table.querySelectorAll('th[data-sort]').forEach(th => {
      let asc = true;
      th.style.cursor = 'pointer';
      th.addEventListener('click', () => {
        const key = th.getAttribute('data-sort');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr')).filter(r => !r.classList.contains('row-missing'));
        const missing = Array.from(tbody.querySelectorAll('tr.row-missing'));
        rows.sort((a, b) => {
          const av = a.dataset[key] || a.querySelector(`.${key === 'symbol' ? 'sym' : 'name'}`)?.textContent || '';
          const bv = b.dataset[key] || b.querySelector(`.${key === 'symbol' ? 'sym' : 'name'}`)?.textContent || '';
          const an = parseFloat(av); const bn = parseFloat(bv);
          const cmp = (!isNaN(an) && !isNaN(bn)) ? (an - bn) : String(av).localeCompare(String(bv));
          return asc ? cmp : -cmp;
        });
        asc = !asc;
        tbody.innerHTML = '';
        rows.forEach(r => tbody.appendChild(r));
        missing.forEach(r => tbody.appendChild(r));
      });
    });
  });

  // Export CSV
  document.getElementById('csvBtn').addEventListener('click', () => {
    const lines = [['category','symbol','name','spec_exp_long','spec_exp_short','spec_net','spec_ext_6m','spec_ext_3y','comm_exp_long','comm_exp_short','comm_net','comm_ext_6m','comm_ext_3y'].join(',')];
    document.querySelectorAll('section.cat').forEach(sec => {
      const cat = sec.getAttribute('data-cat');
      sec.querySelectorAll('tbody tr').forEach(r => {
        if (r.classList.contains('row-missing')) return;
        const d = r.dataset;
        const name = r.querySelector('.name')?.textContent || '';
        lines.push([cat, d.symbol, name.replace(/,/g,''), d.spec_exp_long, d.spec_exp_short, d.spec_net, d.spec_ext_6m, d.spec_ext_3y, d.comm_exp_long, d.comm_exp_short, d.comm_net, d.comm_ext_6m, d.comm_ext_3y].join(','));
      });
    });
    const blob = new Blob([lines.join('\n')], {type: 'text/csv'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `cot-{{ report_date }}.csv`;
    a.click();
  });

  // Archive navigation
  document.getElementById('archiveSel').addEventListener('change', e => {
    window.location.href = e.target.value;
  });
})();
</script>
</body>
</html>
