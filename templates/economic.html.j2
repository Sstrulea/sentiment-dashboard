<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Economic Dashboard | Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  {% include '_navbar.html.j2' %}

  <main class="page-content econ-page">
    <header class="econ-header">
      <h1>Economic Dashboard</h1>
      <div class="econ-meta-bar" id="econMeta">
        <span class="muted">Loading…</span>
      </div>
    </header>

    <div class="econ-legend">
      <span class="muted">Bias from the normalized macro-surprise index. Cells are rounded scores on a
      blue (bullish) ↔ red (bearish) scale; for a pair each indicator cell is the base − quote
      differential. Click a row for the per-indicator breakdown.</span>
    </div>

    <div class="econ-controls">
      <div id="econCcyFilter" class="cat-filter" role="group" aria-label="Filter by currency">
        <span class="cat-filter-label">Currency:</span>
        <div class="cat-chips" id="econCcyChips"><!-- chips injected by economic-chart.js --></div>
        <div class="cat-filter-actions">
          <button type="button" class="cat-action" data-action="all">All</button>
        </div>
      </div>
      <div id="econBiasFilter" class="cat-filter" role="group" aria-label="Filter by bias">
        <span class="cat-filter-label">Bias:</span>
        <div class="cat-chips" id="econBiasChips"><!-- chips injected by economic-chart.js --></div>
        <div class="cat-filter-actions">
          <button type="button" class="cat-action" data-action="all">All</button>
        </div>
      </div>
    </div>

    <section class="retail-table-wrapper">
      <div id="econContent">
        <p class="muted" style="padding: 40px; text-align: center;">Loading economic bias…</p>
      </div>
    </section>

    <section class="crossasset-section" id="crossassetSection" hidden>
      <header class="econ-header crossasset-header">
        <h2>Cross-Asset</h2>
      </header>
      <div class="econ-legend">
        <span class="muted">Indices &amp; metals scored from their home-currency macro categories plus
        the US 10y real yield (DFII10). Each cell is that factor's signed contribution;
        Real Yield shows “—” until the DFII10 feed is live. Click a row for the factor breakdown.</span>
      </div>
      <div id="crossassetContent"></div>
    </section>

    <div id="econDetailModal" class="modal" hidden>
      <div class="modal-backdrop"></div>
      <div class="modal-content">
        <button class="modal-close" type="button" aria-label="Close">&times;</button>
        <div id="econDetailContent"></div>
      </div>
    </div>
  </main>

  <script>window.ECON_DATA_URL = "{{ data_url }}";</script>
  <script src="/economic-chart.js"></script>
</body>
</html>
