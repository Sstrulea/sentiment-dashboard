<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VIX / VIX3M | Dashboard</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
  <script src="/chart.umd.min.js"></script>
  <script src="/chartjs-plugin-annotation.min.js"></script>
</head>
<body>
  {% include '_navbar.html.j2' %}

  <main class="page-content vix-page">

    <header class="vix-header">
      <h1>VIX / VIX3M Ratio</h1>
      <p class="subtitle">Term structure signal. Ratio above 1 indicates short-term volatility premium (stress). Ratio below 1 indicates contango (calm).</p>
    </header>

    <section class="vix-signal-card" id="vix-signal-card">
      <div class="signal-main">
        <span class="label">Ratio (VIX / VIX3M)</span>
        <span class="value huge" id="vix-ratio-value">—</span>
        <span class="date" id="vix-date">—</span>
      </div>
      <div class="signal-regime">
        <span class="label">Regime</span>
        <span class="regime-badge" id="vix-regime">—</span>
        <span class="regime-sub" id="vix-regime-sub">—</span>
        <span class="regime-flip" id="vix-regime-flip" hidden></span>
      </div>
      <div class="signal-components">
        <div>
          <span class="label">VIX</span>
          <span class="value" id="vix-value">—</span>
        </div>
        <div>
          <span class="label">VIX3M</span>
          <span class="value" id="vix3m-value">—</span>
        </div>
        <div>
          <span class="label">Days in regime</span>
          <span class="value" id="vix-days-in-regime">—</span>
        </div>
      </div>
    </section>

    <section class="chart-section">
      <div class="chart-controls">
        <div class="window-selector" role="tablist" aria-label="Time window">
          <button class="win-btn" data-window="3M">3M</button>
          <button class="win-btn active" data-window="6M">6M</button>
          <button class="win-btn" data-window="1Y">1Y</button>
          <button class="win-btn" data-window="3Y">3Y</button>
          <button class="win-btn" data-window="5Y">5Y</button>
          <button class="win-btn" data-window="Max">Max</button>
        </div>
        <div class="toggle-controls">
          <label class="toggle">
            <input type="checkbox" id="crossovers-toggle" checked>
            <span>Show crossovers</span>
          </label>
        </div>
      </div>
      <div class="chart-wrapper">
        <canvas id="vix-chart"></canvas>
      </div>
      <div class="regime-legend">
        <span class="legend-item"><span class="swatch acute-panic"></span> &gt; 1.10 Acute Panic</span>
        <span class="legend-item"><span class="swatch backwardation"></span> 1.00-1.10 Backwardation</span>
        <span class="legend-item"><span class="swatch normal"></span> 0.90-1.00 Normal/Contango</span>
        <span class="legend-item"><span class="swatch complacency"></span> &lt; 0.90 Complacency</span>
      </div>
    </section>

  </main>

  <script>
    window.VIX_DATA_URL = "{{ data_url }}";
  </script>
  <script src="/vix-chart.js"></script>
</body>
</html>
